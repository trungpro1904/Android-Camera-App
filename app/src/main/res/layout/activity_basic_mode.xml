<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.myapplication.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/viewFinder"
        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
        app:layout_constraintStart_toStartOf="@+id/viewFinder"
        app:layout_constraintEnd_toEndOf="@+id/viewFinder" />

    <com.example.myapplication.TrackingOverlayView
        android:id="@+id/trackingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/viewFinder"
        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
        app:layout_constraintStart_toStartOf="@+id/viewFinder"
        app:layout_constraintEnd_toEndOf="@+id/viewFinder" />

    <!-- Top Bar with high elevation to ensure clickability -->
    <include
        android:id="@+id/topBar"
        layout="@layout/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Zoom Controls -->
    <LinearLayout
        android:id="@+id/layoutZoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:elevation="15dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutEvSlider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    </LinearLayout>

    <!-- EV Slider Panel (Updated to match image) -->
    <LinearLayout
        android:id="@+id/layoutEvSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#DD181818"
        android:visibility="gone"
        android:elevation="25dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomSection">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingHorizontal="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="EV"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/btnEvClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/white" />
        </RelativeLayout>

        <com.example.myapplication.ExposureSlider
            android:id="@+id/exposureSlider"
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <!-- Bottom Orange Glow/Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_orange_gradient_line" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/camera_panel_bg"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Contextual Sliding Panel -->
        <LinearLayout
            android:id="@+id/slidingPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/btnToggle"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Preset / LUTs Selector -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLuts"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:clipToPadding="false"
                android:paddingHorizontal="150dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvModes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </FrameLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnToggle"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/camera_accent_orange"
            app:layout_constraintTop_toBottomOf="@+id/slidingPanel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            app:layout_constraintTop_toBottomOf="@+id/btnToggle"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnAlbum"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="32dp"
                android:background="@drawable/bg_rounded_square"
                android:text="album"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:padding="2dp" />

            <View
                android:id="@+id/btnShutter"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal|center_vertical"
                android:background="@drawable/bg_shutter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnFlash"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/selector_flash_status"
                    app:tint="@android:color/white"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/btnSwitch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_switch_camera"
                    app:tint="@android:color/white"
                    android:padding="4dp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
